NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/talentflow
CLIENT_URL=http://localhost:5173

# --- Auth tokens ---
# Access token: short-lived, sent as a Bearer header on every request.
# Refresh token: long-lived, stored as an httpOnly cookie + hashed in the
# database, used only to silently mint a new access token. See
# server/utils/tokens.js and server/controllers/authController.js.
JWT_SECRET=change_this_to_a_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30

# --- HTTPS ---
# In production, set FORCE_HTTPS=true so the server redirects any plain
# HTTP request to HTTPS (works behind a reverse proxy that sets
# X-Forwarded-Proto, e.g. Nginx/Render/Heroku, or standalone — see
# server/middleware/httpsEnforce.js). Leave false for local development.
FORCE_HTTPS=false
# Optional: run Node's own HTTPS listener directly (skip if you terminate
# TLS at a reverse proxy/load balancer instead, which is the common setup).
SSL_KEY_PATH=
SSL_CERT_PATH=

# --- Rate limiting ---
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MIN=15
API_RATE_LIMIT_MAX=300
API_RATE_LIMIT_WINDOW_MIN=15

# Real AI microservice (see ai-service/README.md). If disabled or unreachable,
# the server automatically falls back to the simulated scoring in
# server/utils/aiEvaluation.js so the app still works without it.
AI_SERVICE_ENABLED=false
AI_SERVICE_URL=http://localhost:8000

# Email notifications (see server/utils/mailer.js). If disabled or
# misconfigured, emails are skipped (logged to console) instead of
# crashing the request — in-app notifications still work either way.
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="TalentFlow <no-reply@talentflow.com>"

# --- Logging ---
LOG_LEVEL=info

# --- CSP ---
# Content-Security-Policy is on by default in production, off in dev
# (Vite's dev server needs a looser policy). Override explicitly with
# "true"/"false" if you need to.
CSP_ENABLED=

# --- Optional: Redis cache (job listings) ---
# Leave empty to run without caching — every request just hits MongoDB
# directly, which is fine for small deployments.
REDIS_URL=

# --- Optional: Google "Sign in with Google" ---
# Leave all three empty to keep Google login disabled (GET /api/auth/google
# returns 404). Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# --- Optional: Stripe billing (recruiter "Pro" plan) ---
# Leave empty to keep billing disabled (POST /api/billing/checkout returns 503).
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_PRO=
STRIPE_WEBHOOK_SECRET=

# --- Optional: hCaptcha on register/login ---
# Leave empty to skip captcha verification entirely.
HCAPTCHA_SECRET=

# --- Optional: Sentry error tracking ---
# Leave empty to disable — errors just go to the normal Winston logs.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
